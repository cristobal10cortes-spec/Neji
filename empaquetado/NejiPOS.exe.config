<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de .NET Framework para NejiPOS.exe (va junto al .exe).
     loadFromRemoteSources: permite cargar las DLL del programa aunque Windows las haya marcado
     como descargadas de internet (al descomprimir un .zip), algo que de otro modo impide abrir
     la ventana de Neji POS. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
